# Copie para .env e preencha só o provedor que for usar. O .env não vai para o git.
# Provedor padrão quando o roteiro não diz: elevenlabs | fish | kokoro | nenhuma
VOZ_PROVEDOR=nenhuma

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s1

# Voz neural local (Kokoro, gratuita, roda no computador). Instale: pip install kokoro-onnx soundfile
# e baixe kokoro-v1.0.onnx e voices-v1.0.bin em github.com/thewh1teagle/kokoro-onnx/releases
KOKORO_PYTHON=python3
KOKORO_MODELO=
KOKORO_VOZES=
KOKORO_VOZ=pm_alex
KOKORO_VELOCIDADE=1.0
