# Copie para .env e preencha só o provedor que for usar. O .env não vai para o git.
# Provedor padrão quando o roteiro não diz: elevenlabs | fish | nenhuma
VOZ_PROVEDOR=nenhuma

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s1
